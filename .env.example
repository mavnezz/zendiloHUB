# --- Server ------------------------------------------------------------------
# The image: built here by `docker compose up -d --build` (default), or a published one pulled with `docker compose pull`.
# ZENDILOHUB_IMAGE=ghcr.io/<owner>/zendilohub:latest
# Host port of the web app and the API; point your reverse proxy here.
ZENDILOHUB_HTTP_PORT=8080
# Local files: a named volume by default, or a folder on the host.
# ZENDILOHUB_DATA_PATH=./data
# Owner of the files in ZENDILOHUB_DATA_PATH on the host (`id -u`, `id -g`).
PUID=1000
PGID=1000
# debug, info, warning or error
# ZENDILOHUB_LOG_LEVEL=info
# Addresses/networks of your reverse proxy whose X-Forwarded-* headers are trusted
# (default: private networks and localhost).
# ZENDILOHUB_TRUSTED_PROXIES=172.16.0.0/12
# Interactive API documentation at /api/docs.
# ZENDILOHUB_API_DOCS=true
# The instance's time zone; the setup wizard suggests the browser's.
# ZENDILOHUB_TIMEZONE=Europe/Berlin
# Largest accepted upload (later: attachments).
# ZENDILOHUB_MAX_UPLOAD_MB=25
# Entries of the audit log are deleted after this many days.
# ZENDILOHUB_AUDIT_RETENTION_DAYS=365
# Keys hashes and encrypts secrets at rest; generated into the data directory if not set.
# Keep it (or the data volume) safe: without it, stored secrets cannot be decrypted.
# ZENDILOHUB_SECRET_KEY=
# Memory limits of the containers (Docker notation: 512m, 1g).
# ZENDILOHUB_MEMORY_LIMIT=512m
# POSTGRES_MEMORY_LIMIT=1g
# REDIS_MEMORY_LIMIT=256m

# --- Mode --------------------------------------------------------------------
# false (default): self-hosted. One organization, made by the setup wizard on the first visit (it asks for the setup
# code from the log); only invited people can create an account.
# true: SaaS. Everyone signs up and creates organizations of their own.
# ZENDILOHUB_MULTI_TENANT=false

# --- First administrator (optional) ------------------------------------------
# Instead of the setup wizard: created when the app starts and there is no administrator yet, so only on the first
# start; afterwards both are ignored (change the password in the app). The administrator then creates the
# organization in the app. The password needs 10 to 128 characters.
# ZENDILOHUB_ADMIN_EMAIL=admin@example.org
# ZENDILOHUB_ADMIN_PASSWORD=

# --- E-mail of the app (invitations, account confirmation, password reset) ---
# Without an SMTP host, e-mails are only written to the log (fine for testing).
# ZENDILOHUB_SMTP_HOST=smtp.example.org
# starttls (port 587), ssl (port 465) or none (port 25)
# ZENDILOHUB_SMTP_SECURITY=starttls
# ZENDILOHUB_SMTP_PORT=587
# ZENDILOHUB_SMTP_USERNAME=
# ZENDILOHUB_SMTP_PASSWORD=
# ZENDILOHUB_MAIL_FROM=zendiloHUB <noreply@example.org>
# The public address of the app; required with SMTP, the links in e-mails start with it.
# ZENDILOHUB_PUBLIC_URL=https://help.example.org

# --- Database ----------------------------------------------------------------
# Required. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# POSTGRES_USER=zendilohub
# POSTGRES_DB=zendilohub
